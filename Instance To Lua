local function setUILocked(locked)
    pathBox.TextEditable = not locked
    pathBox.Active = not locked
    dropdownBtn.Active = not locked
    toggleBtn.Active = not locked
    if locked then
        closeDropdown()
        pathBox.BackgroundColor3 = COLORS.surface2
        dropdownBtn.BackgroundColor3 = COLORS.surface2
    else
        pathBox.BackgroundColor3 = COLORS.surface
        dropdownBtn.BackgroundColor3 = COLORS.surface
    end
end

local function setConvertingUI(on)
    converting = on
    convertBtn.Visible = not on
    stopBtn.Visible = on
    setUILocked(on)
    if not on then
        convertBtn.Text = "CONVERT & SAVE"
        convertBtn.BackgroundColor3 = COLORS.accent
        stopBtn.BackgroundColor3 = COLORS.error
    end
end

stopBtn.MouseButton1Click:Connect(function()
    if not converting then return end
    stopRequested = true
    status.Text = "Stopping..."
    status.TextColor3 = COLORS.orange
end)

convertBtn.MouseButton1Click:Connect(function()
    if converting then return end
    stopRequested = false
    setConvertingUI(true)
    closeDropdown()

    local pathText = pathBox.Text
    status.Text = "Converting..."
    status.TextColor3 = COLORS.accent
    setProgress(0)

    task.spawn(function()
        local inst = GetInstance(pathText)
        if not inst then
            status.Text = "Invalid Path"
            status.TextColor3 = COLORS.error
            setProgress(0)
            setConvertingUI(false)
            return
        end

        if stopRequested then
            status.Text = "Stopped"
            status.TextColor3 = COLORS.orange
            setProgress(0)
            setConvertingUI(false)
            return
        end

        updateSaveName()
        status.Text = "Building Lua..."
        status.TextColor3 = COLORS.accent

        local ok, result, lines = saveWithHeader(inst, pathText)

        if stopRequested then
            status.Text = "Stopped"
            status.TextColor3 = COLORS.orange
            setProgress(0)
            setConvertingUI(false)
            return
        end

        setProgress(1)

        if ok then
            local extra = lines and (" (" .. tostring(lines) .. " lines)") or ""
            status.Text = "Saved: " .. tostring(result) .. extra
            status.TextColor3 = COLORS.success
            tween(stopBtn, { BackgroundColor3 = COLORS.success }, 0.15)
            task.wait(1.2)
        else
            status.Text = "Error: " .. tostring(result)
            status.TextColor3 = COLORS.error
            setProgress(0)
        end

        setConvertingUI(false)

        task.delay(2, function()
            if not converting then
                setProgress(0)
                percentLabel.Text = "0%"
                percentLabel.TextColor3 = COLORS.textDim
                if status.TextColor3 == COLORS.success or status.Text == "Stopped" then
                    status.Text = "Ready"
                    status.TextColor3 = COLORS.textDim
                end
            end
        end)
    end)
end)
