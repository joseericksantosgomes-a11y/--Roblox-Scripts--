}

local setProgress
local statusLabel

local function updateRealProgress()
    local pct = 0
    if progressState.totalInstances > 0 then
        pct = math.min(0.98, progressState.processedInstances / progressState.totalInstances)
    end
    if setProgress then setProgress(pct) end
    if statusLabel then
        statusLabel.Text = string.format("%s | %d lines | %d/%d",
            currentMode,
            progressState.totalLines,
            progressState.processedInstances,
            progressState.totalInstances
        )
        statusLabel.TextColor3 = COLORS.accent
    end
end

local function findConverterMethod(names)
    for _, name in ipairs(names) do
        if typeof(converter[name]) == "function" then
            return name, converter[name]
        end
    end
    local mt = getmetatable(converter)
    if mt and typeof(mt.__index) == "table" then
        for _, name in ipairs(names) do
            if typeof(mt.__index[name]) == "function" then
                return name, mt.__index[name]
            end
        end
    end
    return nil, nil
end

local function stripModuleHeader(code)
    if not code or code == "" then return code end
    local lines = string.split(code, "\n")
    local i = 1
    local function isModuleHeaderLine(line)
        if line:match("^%s*$") then return true end
        if not line:match("^%-%-") then return false end
        local patterns = {
            "Generated using",
            "Made by nullspecter",
            "discord%.gg",
            "^%-%-%s*Instance%s*:",
            "Converted on%s*:",
            "Conversion completed",
            "^%-%-%s*Instances%s*:",
            "^%-%-%s*Game%s*:",
            "converter%.ignore",
            "converter%.addComment",
            "converter%.Stream",
            "^%-%-%s*Mode%s*:",
            "Please do your own modification",
            "Total scope",
            "'local' variable",
            "VoidShell",
            "Instance to Lua v",
            "Instance To Lua",
        }
        for _, p in ipairs(patterns) do
            if line:match(p) then return true end
        end
        return false
    end
    while i <= #lines and isModuleHeaderLine(lines[i]) do
        i = i + 1
    end
    while i <= #lines and lines[i]:match("^%s*$") do
        i = i + 1
    end
    return table.concat(lines, "\n", i)
end

local function formatDuration(seconds)
    if seconds < 1 then
        return string.format("%.0f ms", seconds * 1000)
    elseif seconds < 60 then
        return string.format("%.2f seconds", seconds)
    else
        local m = math.floor(seconds / 60)
        local s = seconds % 60
        return string.format("%dm %.1fs", m, s)
    end
end

local function formatSize(bytes)
    if bytes < 1024 then
        return bytes .. " B"
    elseif bytes < 1024 * 1024 then
        return string.format("%.2f KB", bytes / 1024)
    else
        return string.format("%.2f MB", bytes / (1024 * 1024))
    end
end

local function countLines(str)
    if not str or str == "" then return 0 end
    local n = 1
    for _ in str:gmatch("\n") do
        n = n + 1
    end
    return n
end

local function ensureSaveFolder()
    pcall(function()
        if isfolder and not isfolder(SAVE_FOLDER) then
            makefolder(SAVE_FOLDER)
        else
            pcall(makefolder, SAVE_FOLDER)
        end
    end)
end

local function withChildrenDetached(instance, fn)
    local kids = instance:GetChildren()
    for _, c in ipairs(kids) do
        c.Parent = nil
    end
    local results = table.pack(pcall(fn))
    for _, k in ipairs(kids) do
        pcall(function() k.Parent = instance end)
    end
    if not results[1] then
        error(results[2])
    end
    return table.unpack(results, 2, results.n)
end

local function saveWithHeader(instance, pathText)
    pcall(function() converter.Stream = false end)

    local instanceCount
    if deepConvert then
        instanceCount = math.max(1, #instance:GetDescendants() + 1)
    else
        instanceCount = 1
    end

    progressState.totalInstances = instanceCount
    progressState.processedInstances = 0
    progressState.totalLines = 0
    progressState.linesSinceWait = 0

    local cfg = MODE_CONFIG[currentMode] or MODE_CONFIG["Default"]
    local batch = cfg.batch
    local delay = cfg.delay

    local hooks = {}
    local addLineName, origAddLine = findConverterMethod({"_addLine", "addLine", "AddLine"})
    local dumpName, origDump = findConverterMethod({"_dumpInstance", "dumpInstance", "DumpInstance", "_dump", "dump"})

    if addLineName and origAddLine then
        hooks.addLineName = addLineName
        hooks.origAddLine = origAddLine
        converter[addLineName] = function(self, linesTable, lineText, ...)
            if stopRequested then return end
            local isMessages = (self and self.messages and linesTable == self.messages)
            if not isMessages then
                progressState.totalLines = progressState.totalLines + 1
                progressState.linesSinceWait = progressState.linesSinceWait + 1
                updateRealProgress()
                if progressState.linesSinceWait >= batch then
                    progressState.linesSinceWait = 0
                    if delay > 0 and not stopRequested then
                        task.wait(delay)
                    end
                end
            end
            return origAddLine(self, linesTable, lineText, ...)
        end
    end

    if dumpName and origDump then
        hooks.dumpName = dumpName
        hooks.origDump = origDump
        converter[dumpName] = function(self, obj, ...)
            if stopRequested then return end
            progressState.processedInstances = progressState.processedInstances + 1
            updateRealProgress()
            return origDump(self, obj, ...)
        end
    end

    local startTime = os.clock()
    local code
    local okConv, errConv = pcall(function()
        if deepConvert then
            code = converter:convert(instance, "Reusable")
        else
            withChildrenDetached(instance, function()
                code = converter:convert(instance, "Reusable")
            end)
        end
    end)
    local duration = os.clock() - startTime

    if hooks.addLineName then
        converter[hooks.addLineName] = hooks.origAddLine
    end
    if hooks.dumpName then
        converter[hooks.dumpName] = hooks.origDump
    end

    if stopRequested then
        return false, "Stopped by user"
    end

    if not okConv or not code or code == "" then
        return false, tostring(errConv or "Conversion failed")
    end

    code = stripModuleHeader(code)

    local name = instance.Name or "Unknown"
    local cleanName = name:gsub("[^%w%s%-_]", ""):gsub("%s+", "_")
    local fileName = "INSTANCE SAVED -[" .. cleanName .. "].lua"

    local gameName = "Unknown"
    pcall(function()
        local info = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
        if info and info.Name then
            gameName = info.Name
        end
    end)
    if gameName == "Unknown" then
        pcall(function()
            gameName = tostring(game.Name or "Unknown")
        end)
    end

    local header = table.concat({
        "-- ---------- File Information ----------",
        "",
        "-- Path Converted: " .. pathText,
        "-- Conversion Mode: " .. tostring(currentMode),
        "-- Conversion Completed In: " .. formatDuration(duration),
        "-- Instances Inside: " .. tostring(instanceCount),
        "-- Converted File Size: PENDING",
        "-- Lines: PENDING",
        "-- Converted In The Game Called: " .. tostring(gameName),
        "",
        "-- ---------- Converted By Erickzzz Path/Instance To Lua ----------",
        "",
        code
    }, "\n")

    local lineCount = countLines(header)
    header = header
        :gsub("%-%- Converted File Size: PENDING", "-- Converted File Size: " .. formatSize(#header), 1)
        :gsub("%-%- Lines: PENDING", "-- Lines: " .. tostring(lineCount), 1)

    header = header:gsub(
        "%-%- Converted File Size: [^\n]+",
        "-- Converted File Size: " .. formatSize(#header),
        1
    )

    ensureSaveFolder()
    local fullPath = SAVE_FOLDER .. "/" .. fileName

    local ok, err = pcall(function()
        writefile(fullPath, header)
    end)
    return ok, (ok and fullPath) or tostring(err), progressState.totalLines
end

