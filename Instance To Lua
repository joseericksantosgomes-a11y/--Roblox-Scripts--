setProgress = function(value)
    value = math.clamp(value, 0, 1)
    local color
    if value < 0.25 then color = COLORS.red
    elseif value < 0.50 then color = COLORS.orange
    elseif value < 0.75 then color = COLORS.yellow
    else color = COLORS.green end
    tween(progressFill, { Size = UDim2.new(value, 0, 1, 0), BackgroundColor3 = color }, 0.15)
    percentLabel.Text = math.floor(value * 100) .. "%"
    percentLabel.TextColor3 = color
end

