            shown = shown + 1
            local row = Instance.new("Frame", SLS)
            row.Size = UDim2.new(1,0,0,24); row.BackgroundColor3 = Color3.fromRGB(0,0,0)
            row.BackgroundTransparency = 0.5; row.BorderSizePixel = 0; row.LayoutOrder = i
