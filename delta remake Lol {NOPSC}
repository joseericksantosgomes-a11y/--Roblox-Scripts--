            cb.Text = (Settings[opt.id] and "[X] " or "[  ] ")..T(opt.label)
            cb.BackgroundColor3 = Settings[opt.id] and Color3.fromRGB(0,130,220) or Color3.fromRGB(40,40,50)
            persist()
            local q = SBox.Text
            if q and q:gsub("%s","")~="" then doSearch(q) end
        end)
    end
end)

