local BUILTINS = {["print"]=1,["warn"]=1,["error"]=1,["pcall"]=1,["xpcall"]=1,["require"]=1,["loadstring"]=1,["assert"]=1,["tostring"]=1,["tonumber"]=1,["type"]=1,["typeof"]=1,["pairs"]=1,["ipairs"]=1,["next"]=1,["select"]=1,["setmetatable"]=1,["getmetatable"]=1,["rawget"]=1,["rawset"]=1,["table"]=1,["string"]=1,["math"]=1,["os"]=1,["coroutine"]=1,["task"]=1,["wait"]=1,["spawn"]=1,["delay"]=1,["tick"]=1,["time"]=1,["getgenv"]=1,["getrenv"]=1,["hookfunction"]=1,["hookmetamethod"]=1,["getrawmetatable"]=1,["setreadonly"]=1,["firetouchinterest"]=1,["fireclickdetector"]=1,["syn"]=1,["identifyexecutor"]=1,["getconnections"]=1,["setclipboard"]=1,["writefile"]=1,["readfile"]=1,["isfile"]=1,["isfolder"]=1,["makefolder"]=1,["listfiles"]=1,["delfile"]=1,["setfpscap"]=1,["raknet"]=1,["gethui"]=1,["cloneref"]=1,["getcustomasset"]=1}
local COL = {keyword="#C586C0",literal="#569CD6",global="#4EC9B0",builtin="#4FC1FF",funcCall="#DCDCAA",method="#DCDCAA",field="#9CDCFE",string="#CE9178",number="#B5CEA8",comment="#6A9955",operator="#D4D4D4",punct="#808080",plain="#D4D4D4"}
local function esc(s) return (s:gsub("&","&amp;"):gsub("<","&lt;"):gsub(">","&gt;")) end
local function wrap(c, t) return '<font color="'..c..'">'..t..'</font>' end
local function colorize(code)
    if #code > 50000 then return wrap(COL.plain, esc(code)) end
    local out = {}; local i, n = 1, #code
    while i <= n do
        local c = code:sub(i,i); local c2 = code:sub(i,i+1)
        if c == "[" then
            local eqs = code:sub(i,i+20):match("^%[(=*)%[")
            if eqs then local close = "]"..eqs.."]" local cp = code:find(close, i+#eqs+2, true) local ep = cp and (cp+#close-1) or n
                table.insert(out, wrap(COL.string, esc(code:sub(i,ep)))); i = ep+1
            else table.insert(out, wrap(COL.punct, esc(c))); i = i+1 end
        elseif c2 == "--" then
            local eqs = code:sub(i,i+20):match("^%-%-%[(=*)%[")
            if eqs then local close = "]"..eqs.."]" local cp = code:find(close, i+4+#eqs, true) local ep = cp and (cp+#close-1) or n
                table.insert(out, '<i>'..wrap(COL.comment, esc(code:sub(i,ep)))..'</i>'); i = ep+1
            else local nl = code:find("\n", i, true) local ep = nl and (nl-1) or n
                table.insert(out, '<i>'..wrap(COL.comment, esc(code:sub(i,ep)))..'</i>'); i = ep+1
            end
        elseif c == '"' or c == "'" then
            local j = i+1
            while j <= n do local cj = code:sub(j,j)
                if cj == "\\" then j = j+2
                elseif cj == c then j = j+1; break
                elseif cj == "\n" then break
                else j = j+1 end
            end
            table.insert(out, wrap(COL.string, esc(code:sub(i, j-1)))); i = j
        elseif c:match("%d") then
            local j = i
            while j < n and code:sub(j+1,j+1):match("[%d%.xXa-fA-F]") do j = j+1 end
            table.insert(out, wrap(COL.number, esc(code:sub(i,j)))); i = j+1
        elseif c:match("[%a_]") then
            local j = i
            while j < n and code:sub(j+1,j+1):match("[%w_]") do j = j+1 end
            local word = code:sub(i,j)
            local k = i-1; while k >= 1 and code:sub(k,k):match("%s") do k = k-1 end
            local pv = k >= 1 and code:sub(k,k) or ""
            local k2 = j+1; while k2 <= n and code:sub(k2,k2):match("%s") do k2 = k2+1 end
            local nx = code:sub(k2,k2)
            local isCall = (nx == "(" or nx == "{" or nx == '"' or nx == "'")
            local col
            if LITERALS[word] then col = COL.literal
            elseif KEYWORDS[word] then col = COL.keyword
            elseif GLOBALS[word] then col = COL.global
            elseif BUILTINS[word] then col = COL.builtin
            elseif pv == "." then col = isCall and COL.method or COL.field
            elseif pv == ":" then col = COL.method
            elseif isCall then col = COL.funcCall
            else col = COL.plain end
            table.insert(out, wrap(col, esc(word))); i = j+1
        elseif c:match("%s") then table.insert(out, esc(c)); i = i+1
        elseif c:match("[%+%-%*/%%%^#=<>~&|!]") then table.insert(out, wrap(COL.operator, esc(c))); i = i+1
        elseif c:match("[%(%){}%[%],;:%.]") then table.insert(out, wrap(COL.punct, esc(c))); i = i+1
        else table.insert(out, esc(c)); i = i+1 end
    end
    return table.concat(out)
end

