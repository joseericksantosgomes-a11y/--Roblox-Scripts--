local API = "https://scriptblox.com/api/script/search"
local function clrR()
    for _, c in ipairs(RSc:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    RSc.CanvasSize = UDim2.new(0,0,0,0)
end
local function doSearch(q)
    clrR(); EL.Text = T("Blox_Searching"); EL.Visible = true
    local url = API.."?q="..HttpService:UrlEncode(q).."&max=50"
    local ok, res = pcall(function()
        return HttpService:RequestAsync({Url=url,Method="GET",Headers={["User-Agent"]="Mozilla/5.0",["Accept"]="application/json"}})
    end)
    if not ok or not res or not res.Success then EL.Text = T("Blox_Fail") return end
    local data
    local ok2 = pcall(function() data = HttpService:JSONDecode(res.Body) end)
    if not ok2 or not data or not data.result or not data.result.scripts then EL.Text = T("Blox_NoData") return end
    local scs = data.result.scripts
    if #scs == 0 then EL.Text = T("Blox_NoResults") return end
    local sortKey = nil
    if Settings.SortViews then sortKey = "views"
    elseif Settings.SortExecuted then sortKey = "executed"
    elseif Settings.SortLatest then sortKey = "latest" end
    if sortKey == "views" then
        table.sort(scs, function(a,b) return (tonumber(a.views) or 0) > (tonumber(b.views) or 0) end)
    elseif sortKey == "executed" then
        table.sort(scs, function(a,b)
            local av = tonumber(a.executions or a.views) or 0
            local bv = tonumber(b.executions or b.views) or 0
            return av > bv
        end)
    elseif sortKey == "latest" then
        table.sort(scs, function(a,b)
            return (parseIso(a.createdAt) or 0) > (parseIso(b.createdAt) or 0)
        end)
    end
    EL.Visible = false
    local shown = math.min(15, #scs)
    for i = 1, shown do mkCard(scs[i], (i-1)*110) end
    RSc.CanvasSize = UDim2.new(0,0,0, shown*110+10)
end

