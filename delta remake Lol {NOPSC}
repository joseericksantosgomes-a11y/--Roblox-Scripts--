local function renderC(l, lab) lab.Text = table.concat(l, "\n") end
local function msgCol(mt)
    if mt == Enum.MessageType.MessageWarning then return "#FFCC44" end
    if mt == Enum.MessageType.MessageError then return "#FF6666" end
    if mt == Enum.MessageType.MessageInfo then return "#66CCFF" end
    return "#DDDDDD"
end
local function appendC(m, mt)
    local co = msgCol(mt)
    local ln = '<font color="'..co..'">'..esc(tostring(m))..'</font>'
    table.insert(rL, ln); while #rL > 200 do table.remove(rL, 1) end
    renderC(rL, RT)
    if mt == Enum.MessageType.MessageOutput or mt == Enum.MessageType.MessageWarning then
        table.insert(dL, ln); while #dL > 200 do table.remove(dL, 1) end
        renderC(dL, DT)
    end
end
