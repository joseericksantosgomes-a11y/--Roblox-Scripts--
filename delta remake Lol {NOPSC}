local function parseIso(iso)
    if type(iso)=="number" then return iso end
    if type(iso)~="string" then return nil end
    local y,mo,d,h,mi,s = iso:match("(%d+)-(%d+)-(%d+)T(%d+):(%d+):(%d+)")
    if not y then return nil end
    return os.time({year=tonumber(y),month=tonumber(mo),day=tonumber(d),hour=tonumber(h),min=tonumber(mi),sec=tonumber(s)})
end
local function timeAgo(u)
    if not u then return "?" end
    local df = os.time()-u
    if df<60 then return df.."s" end
    if df<3600 then return math.floor(df/60).."m" end
    if df<86400 then return math.floor(df/3600).."h" end
    if df<604800 then return math.floor(df/86400).."d" end
    if df<2592000 then return math.floor(df/604800).."w" end
    return math.floor(df/2592000).."mo"
end
local function fmtN(n) n=tonumber(n) or 0
    if n>=1e6 then return string.format("%.1fM",n/1e6) end
    if n>=1e3 then return string.format("%.1fK",n/1e3) end
    return tostring(n)
end

