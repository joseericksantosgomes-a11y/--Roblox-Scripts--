local HAS_FS = (isfolder and makefolder and writefile and readfile and isfile) and true or false
local mem = {}
local function f_exists(p) if not HAS_FS then return mem[p] ~= nil end local ok,r = pcall(isfile, p); return ok and r end
local function f_write(p, c) if not HAS_FS then mem[p]=c; return end pcall(writefile, p, c) end
local function f_read(p) if not HAS_FS then return mem[p] end if not f_exists(p) then return nil end local ok,r = pcall(readfile, p); if ok then return r end end
local function f_del(p) if not HAS_FS then mem[p]=nil; return end pcall(delfile, p) end
local function f_list(fd)
    if not HAS_FS then local o={} for k in pairs(mem) do if k:sub(1,#fd)==fd then table.insert(o,k) end end return o end
    local ok, l = pcall(listfiles, fd); return (ok and l) or {}
end

