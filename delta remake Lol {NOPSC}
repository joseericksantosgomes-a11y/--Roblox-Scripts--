local refreshList
refreshList = function(fil)
    fil = (fil or ""):lower()
    for _, c in ipairs(SLS:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    local files = SavedScripts.list(); local shown = 0
    for i, name in ipairs(files) do
