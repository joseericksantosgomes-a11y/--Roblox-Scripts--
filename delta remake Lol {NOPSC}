            nb.Size = UDim2.new(1,-42,1,0); nb.BackgroundTransparency = 1
            nb.Text = name; nb.TextColor3 = Color3.fromRGB(255,255,255)
            nb.TextSize = 12; nb.Font = Enum.Font.SourceSans
            nb.TextTruncate = Enum.TextTruncate.AtEnd
            nb.TextXAlignment = Enum.TextXAlignment.Left; nb.BorderSizePixel = 0
            nb.MouseButton1Click:Connect(function()
                local d = SavedScripts.read(name)
                if d then Ed.Text = d; if Settings.SyntaxHighlight then refreshOverlay() end end
            end)
            local rb = Instance.new("TextButton", row)
            rb.Size = UDim2.new(0,18,1,-2); rb.Position = UDim2.new(1,-40,0,1)
            rb.BackgroundColor3 = Color3.fromRGB(60,60,90)
            rb.Text = "R"; rb.TextColor3 = Color3.fromRGB(255,255,255); rb.TextSize = 12
            rb.Font = Enum.Font.SourceSansBold; rb.BorderSizePixel = 0
            Instance.new("UICorner", rb)
            rb.MouseButton1Click:Connect(function()
                showRename(name, function(nn)
                    if SavedScripts.rename(name, nn) then refreshList(SSB.Text) end
                end)
            end)
            local db = Instance.new("TextButton", row)
            db.Size = UDim2.new(0,18,1,-2); db.Position = UDim2.new(1,-20,0,1)
            db.BackgroundColor3 = Color3.fromRGB(120,40,40)
            db.Text = "X"; db.TextColor3 = Color3.fromRGB(255,255,255); db.TextSize = 12
            db.Font = Enum.Font.SourceSansBold; db.BorderSizePixel = 0
            Instance.new("UICorner", db)
            db.MouseButton1Click:Connect(function()
                SavedScripts.delete(name); refreshList(SSB.Text)
            end)
        end
    end
    SLE.Visible = (shown == 0)
end
